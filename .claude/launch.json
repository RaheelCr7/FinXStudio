{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bank-app-web",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd apps/bank-app && CI=1 EXPO_NO_TELEMETRY=1 npx expo start --web --port 8081"
      ],
      "port": 8081
    },
    {
      "name": "studio",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd apps/studio && npx next dev --port 3100 --hostname 127.0.0.1"
      ],
      "port": 3100
    },
    {
      "name": "bank-web",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd apps/bank-web && npx next dev --port 3200 --hostname 127.0.0.1"
      ],
      "port": 3200
    }
  ]
}
